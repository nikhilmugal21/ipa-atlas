      "CompareRequest": {
        "properties": {
          "a": {
            "type": "string",
            "maxLength": 15,
            "minLength": 1,
            "title": "A"
          },
          "b": {
            "type": "string",
            "maxLength": 15,
            "minLength": 1,
            "title": "B"
